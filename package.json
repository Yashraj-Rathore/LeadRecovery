{
  "name": "leadrecovery",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.10.0"
  },
  "scripts": {
    "frontend:build": "pnpm --dir src/LeadRecovery.Web build",
    "frontend:dev": "pnpm --dir src/LeadRecovery.Web dev",
    "frontend:start": "pnpm --dir src/LeadRecovery.Web start",
    "frontend:typecheck": "pnpm --dir src/LeadRecovery.Web typecheck",
    "openapi:lint": "redocly lint api/openapi.yaml --extends=minimal",
    "e2e": "pnpm --dir tests/LeadRecovery.E2E test"
  },
  "devDependencies": {
    "@redocly/cli": "2.40.0"
  }
}
