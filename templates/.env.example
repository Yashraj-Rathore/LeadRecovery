# Environment
ASPNETCORE_ENVIRONMENT=Development
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
SERVER_API_BASE_URL=http://localhost:8080

# Container build metadata and optional host-port overrides
IMAGE_VERSION=0.9.0-local
IMAGE_REVISION=unknown
IMAGE_CREATED=unknown
API_PORT=8080
WORKER_HEALTH_PORT=8081
WEB_PORT=3000

# Database - local example only
POSTGRES_DB=leadrecovery
POSTGRES_USER=leadrecovery
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
CONNECTIONSTRINGS__DATABASE=Host=localhost;Port=5432;Database=leadrecovery;Username=leadrecovery;Password=change-me-local-only

# Authentication/Data Protection
AUTH_COOKIE_NAME=leadrecovery.session
DATA_PROTECTION_KEY_PATH=/keys
RATELIMITING__LOGINPERMITLIMIT=5
RATELIMITING__MANUALMESSAGEPERMITLIMIT=10
RATELIMITING__WEBHOOKTOKENLIMIT=200
RATELIMITING__WEBHOOKTOKENSPERSECOND=40

# Fictional demo seed - opt in only for a disposable local database.
# Supply all values when DEMOSEED__ENABLED=true; never commit real credentials.
DEMOSEED__ENABLED=false
DEMOSEED__OWNEREMAIL=
DEMOSEED__OWNERPASSWORD=
DEMOSEED__STAFFEMAIL=
DEMOSEED__STAFFPASSWORD=
DEMOSEED__BETAOWNEREMAIL=
DEMOSEED__BETAOWNERPASSWORD=
DEMOSEED__ALPHAURGENTPHONE=
DEMOSEED__ALPHABOOKINGPHONE=
DEMOSEED__BETALEADPHONE=
DEMOSEED__ALPHAPROVIDERPHONE=
DEMOSEED__BETAPROVIDERPHONE=

# Twilio - leave blank when using fake provider
SMS_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_BASE_URL=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_TEST_MODE=true
TWILIO_ALLOWED_TEST_NUMBERS=

# Email
EMAIL_PROVIDER=fake
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# AI - optional
# Set AI_ENABLED consistently in both the API and Worker processes.
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-sol
AI_CATEGORY_QUESTION_KEY=service
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MILLISECONDS=250
AI_MAX_OUTPUT_TOKENS=1000

# Jobs
JOBS_WORKER_COUNT=4
SMS_WORKER_COUNT=2

# Retention - Worker only. Start with dry-run and inspect audit manifests.
# A tenant policy must also be enabled. Delete mode has no application undo.
RETENTION_ENABLED=false
RETENTION_MODE=dry-run
RETENTION_BATCH_SIZE=100
RETENTION_CRON=0 2 * * *
# Set true only after verifying a current backup/PITR recovery point.
RETENTION_BACKUP_CONFIRMED=false

# Telemetry
# Leave blank for local JSON logs only. Set an absolute collector URL to export
# OTLP traces and metrics from both API and Worker (for example, http://otel:4317).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Trace, Debug, Information, Warning, Error, Critical, or None.
LOG_LEVEL=Information

# Safety
# Fail closed. Set true in both API and Worker only when automation should run.
AUTOMATION_GLOBAL_ENABLED=false
ALLOW_REAL_SMS=false
