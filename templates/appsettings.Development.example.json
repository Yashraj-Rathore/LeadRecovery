{
  "AllowedHosts": "localhost",
  "LeadRecovery": {
    "PublicAppUrl": "http://localhost:3000",
    "AutomationGlobalEnabled": false,
    "AllowRealSms": false,
    "DefaultInitialDelaySeconds": 30,
    "DefaultCooldownMinutes": 120
  },
  "Twilio": {
    "UseFakeProvider": true
  },
  "RateLimiting": {
    "LoginPermitLimit": 5,
    "ManualMessagePermitLimit": 10
  },
  "DemoSeed": {
    "Enabled": false,
    "OwnerEmail": "",
    "OwnerPassword": "",
    "StaffEmail": "",
    "StaffPassword": "",
    "BetaOwnerEmail": "",
    "BetaOwnerPassword": "",
    "AlphaUrgentPhone": "",
    "AlphaBookingPhone": "",
    "BetaLeadPhone": "",
    "AlphaProviderPhone": "",
    "BetaProviderPhone": ""
  },
  "Ai": {
    "Enabled": false,
    "Provider": "OpenAI",
    "TimeoutSeconds": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
