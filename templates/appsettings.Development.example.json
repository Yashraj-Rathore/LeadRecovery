{
  "AllowedHosts": "localhost",
  "LeadRecovery": {
    "PublicAppUrl": "http://localhost:3000",
    "AutomationGlobalEnabled": false,
    "AllowRealSms": false,
    "DefaultInitialDelaySeconds": 30,
    "DefaultCooldownMinutes": 120
  },
  "Twilio": {
    "UseFakeProvider": true
  },
  "RateLimiting": {
    "LoginPermitLimit": 5,
    "ManualMessagePermitLimit": 10,
    "WebhookTokenLimit": 200,
    "WebhookTokensPerSecond": 40
  },
  "DemoSeed": {
    "Enabled": false,
    "OwnerEmail": "",
    "OwnerPassword": "",
    "StaffEmail": "",
    "StaffPassword": "",
    "BetaOwnerEmail": "",
    "BetaOwnerPassword": "",
    "AlphaUrgentPhone": "",
    "AlphaBookingPhone": "",
    "BetaLeadPhone": "",
    "AlphaProviderPhone": "",
    "BetaProviderPhone": ""
  },
  "Ai": {
    "Enabled": false,
    "Provider": "OpenAI",
    "Model": "gpt-5.6-sol",
    "TimeoutSeconds": 15,
    "MaximumRetryCount": 2,
    "RetryBaseDelayMilliseconds": 250,
    "MaximumOutputTokens": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
